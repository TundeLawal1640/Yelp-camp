<% layout('layouts/boilerplate') %>

<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
      <!-- Limit width here -->
      <h1 class="mb-4">Edit Campground</h1>

      <form
        action="/campgrounds/edit/<%= campground._id %>?_method=PATCH"
        method="POST"
        class="row g-2 needs-validation"
        novalidate
      >
        <div class="mb-3">
          <label for="campName" class="form-label">Name</label>
          <input
            type="text"
            name="name"
            value="<%= campground.name %>"
            id="campName"
            class="form-control"
            required
          />
          <div class="invalid-feedback">Please enter valid camp name.</div>
        </div>

        <div class="mb-3">
          <label for="campLoc" class="form-label">Location</label>
          <input
            type="text"
            name="location"
            value="<%= campground.location %>"
            id="campLoc"
            class="form-control"
            required
          />
          <div class="invalid-feedback">Please enter camp location.</div>
        </div>

        <div class="mb-3">
          <label for="campPrice" class="form-label">Price</label>
          <input
            type="text"
            placeholder="enter camp price"
            name="price"
            id="campPrice"
            value="<%= campground.price %>"
            class="form-control"
            required
          />
          <div class="invalid-feedback">Please enter camp price.</div>
        </div>

        <div class="mb-3">
          <label for="campDesc" class="form-label">Description</label>
          <textarea
            name="description"
            id="campDesc"
            class="form-control"
            rows="4"
            required
          >
<%= campground.description %></textarea
          >
          <div class="invalid-feedback">Please enter camp description.</div>
        </div>

        <div class="d-flex gap-2">
          <button type="submit" class="btn btn-success">Update</button>
          <a href="/campgrounds" class="btn btn-secondary">Back</a>
        </div>
      </form>
    </div>
  </div>
</div>
