<% layout('layouts/boilerplate') %>

<style>
  .error-container {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .error-card {
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    border: none;
    border-left: 4px solid #dc3545;
  }
  .error-icon {
    color: #dc3545;
  }
  .stack-trace {
    max-height: 300px;
    overflow-y: auto;
    background-color: #f8f9fa;
    border-radius: 4px;
    padding: 1rem;
    font-family: 'Courier New', monospace;
    font-size: 0.85rem;
  }
</style>

<div class="error-container">
  <div class="container">
    <div class="row">
      <div class="col-md-8 offset-md-2 col-lg-6 offset-lg-3">
        <div class="card error-card">
          <div class="card-body">
            <!-- Error Header -->
            <div class="text-center mb-4">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="64"
                height="64"
                fill="currentColor"
                class="bi bi-exclamation-triangle-fill error-icon mb-3"
                viewBox="0 0 16 16"
              >
                <path
                  d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"
                />
              </svg>
              <h2 class="text-danger">Error <%= statusCode %></h2>
              <p class="text-muted fs-5"><%= message %></p>
            </div>

            <!-- Stack Trace -->
            <% if (typeof stack !== 'undefined' && stack) { %>
              <div class="accordion" id="errorDetails">
                <div class="accordion-item border-0">
                  <h2 class="accordion-header" id="headingOne">
                    <button class="accordion-button collapsed bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="false" aria-controls="collapseOne">
                      <i class="bi bi-bug me-2"></i> View Technical Details
                    </button>
                  </h2>
                  <div id="collapseOne" class="accordion-collapse collapse" aria-labelledby="headingOne" data-bs-parent="#errorDetails">
                    <div class="accordion-body p-0 mt-2">
                      <div class="stack-trace">
                        <pre class="mb-0"><%= stack %></pre>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            <% } %>

            <!-- Action Buttons -->
            <div class="text-center mt-4">
              <a href="/campgrounds" class="btn btn-primary">
                Back to Campgrounds
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>