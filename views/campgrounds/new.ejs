<% layout('layouts/Boilerplate') %>

<div class="container py-4">
  <div class="row">
    <div class="col-md-6 offset-md-3">
      <h1 class="mb-4 text-center">Create a new Campground</h1>

      <form
        action="/campgrounds"
        method="post"
        class="row g-2 needs-validation"
        novalidate
        enctype="multipart/form-data"
      >
        <div class="mb-3">
          <label for="campName" class="form-label">Name</label>
          <input
            type="text"
            placeholder="enter camp name"
            name="name"
            id="campName"
            class="form-control"
            required
          />
          <div class="invalid-feedback">Please enter valid camp name.</div>
        </div>

        <div class="mb-3">
          <label for="campLoc" class="form-label">Location</label>
          <input
            type="text"
            placeholder="where is the camp located?"
            name="location"
            id="campLoc"
            class="form-control"
            required
          />
          <div class="invalid-feedback">Please enter a location.</div>
        </div>

        <div class="mb-3">
          <label for="campPrice" class="form-label">Price</label>
          <input
            type="text"
            placeholder="enter camp price"
            name="price"
            id="campPrice"
            class="form-control"
            required
          />
          <div class="invalid-feedback">Please enter camp price.</div>
        </div>

        <div class="mb-3">
          <label for="campDesc" class="form-label">Description</label>
          <textarea
            placeholder="Briefly describe the campground"
            name="description"
            id="campDesc"
            class="form-control"
            rows="4"
            required
          ></textarea>
          <div class="invalid-feedback">Please describe camp.</div>
        </div>

        <div class="mb-3">
          <label for="campImages" class="form-label">Upload Photos</label>
          <input
            type="file"
            name="images"
            id="campImages"
            class="form-control"
            multiple
            accept="image/*"
          />
          <div class="form-text">
            Upload one or more images. If none provided, a random image will be
            used.
          </div>
        </div>

        <div class="d-flex gap-2">
          <button type="submit" class="btn btn-success">Create</button>
          <a href="/campgrounds" class="btn btn-primary">Back</a>
        </div>
      </form>
    </div>
  </div>
</div>
