    <% layout('layouts/Boilerplate') %>

    <!-- rating stars -->
    <link rel="stylesheet" href="/stylesheet/star.css">

    <div class="container py-4">
      <div class="row g-4">

        <!-- Left Column: Campground Details -->
        <div class="col-12 col-md-6">
          <!-- Wrapped in a card with a subtle shadow -->
          <div class="card shadow-sm h-100">

            <!-- Flush image at the top of the card for a polished look -->
            <img
              src="<%= campground.imageUrl %>"
              alt="Campground Image"
              class="card-img-top"
              style="height: 320px; object-fit: cover;"
            />

            <div class="card-body d-flex flex-column">
              <h1 class="card-title mb-1"><%= campground.name %></h1>
              <h5 class="text-muted mb-3"><%= campground.location %></h5>

              <p class="fst-italic text-muted small">
                Posted by - <%= campground.author ? campground.author.username : "Unknown" %>
              </p>

              <p class="card-text flex-grow-1"><%= campground.description %></p>
              <h4 class="card-text fw-bold mb-4">$<%= campground.price %></h4>

              <!-- Action buttons pushed to the bottom using mt-auto -->
              <div class="d-flex gap-2 mt-auto">
                <% if (currentUser && campground.author && campground.author.equals(currentUser._id)) { %>
                  <a
                    href="/campgrounds/edit/<%= campground._id %>"
                    class="btn btn-primary"
                  >
                    Edit
                  </a>

                  <form
                    action="/campgrounds/<%= campground._id %>?_method=delete"
                    method="POST"
                  >
                    <button class="btn btn-danger">Delete</button>
                  </form>
                <% } %>

                <a href="/campgrounds" class="btn btn-secondary">Back</a>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column: Reviews Form -->
        <div class="col-12 col-md-6">
          <!-- Added shadow-sm here to match the left card -->
          <div class="card shadow-sm h-100">
            <div class="card-body">

              <h2 class="text-center mb-3">Leave A Review</h2>

              <form
                action="/campgrounds/<%= campground._id %>/review"
                method="POST"
                class="needs-validation"
                novalidate
              >
                <div class="mb-3">
                  <label class="form-label text-muted fw-bold">Rate Camp</label>
                 <fieldset class="starability-basic">
                    <input type="radio" id="no-rate" class="input-no-rate" name="rating" value="1" checked aria-label="No rating." />
                    <input type="radio" id="first-rate1" name="rating" value="1" />
                    <label for="first-rate1" title="Terrible">1 star</label>
                    <input type="radio" id="first-rate2" name="rating" value="2" />
                    <label for="first-rate2" title="Not good">2 stars</label>
                    <input type="radio" id="first-rate3" name="rating" value="3" />
                    <label for="first-rate3" title="Average">3 stars</label>
                    <input type="radio" id="first-rate4" name="rating" value="4" />
                    <label for="first-rate4" title="Very good">4 stars</label>
                    <input type="radio" id="first-rate5" name="rating" value="5" />
                    <label for="first-rate5" title="Amazing">5 stars</label>
                </fieldset>
                </div>

                <div class="mb-3">
                  <label class="form-label text-muted fw-bold">Comment</label>
                  <textarea
                    class="form-control"
                    name="body"
                    rows="3"
                    required
                  ></textarea>
                  <div class="invalid-feedback">
                    Review field cannot be empty!
                  </div>
                </div>

                <button class="btn btn-success w-100 fw-bold">Submit</button>
              </form>

              <hr class="my-4" />

              <h4 class="text-center mb-3">Reviews</h4>

              <% for (let review of campground.reviews) { %>
                <!-- Sub-card for individual reviews, given a lighter background -->
                <div class="card mb-3 bg-light border-0">
                  <div class="card-body">
                    <h6 class="card-subtitle mb-4">


                          Posted by - <%=review.author.username %>

                    <i><p class="card-text text-muted"><%= review.body %></p></i>

                      <!-- star rating -->
                      <p class="starability-result" data-rating="<%= review.rating %>">
                        Rating: <%= review.rating %> stars
                      </p>
                    </h6>


                    <% if (currentUser && review.author && review.author.equals(currentUser._id)) { %>
                      <form
                        action="/campgrounds/<%= campground._id %>/review/<%= review._id %>?_method=delete"
                        method="POST"
                      >
                        <button class="btn btn-sm btn-outline-danger">Delete</button>
                      </form>
                    <% } %>
                  </div>
                </div>
              <% } %>

            </div>
          </div>
        </div>

      </div>
    </div>