<% layout('layouts/boilerplate') %>
<link rel="stylesheet" href="/stylesheet/star.css">

<%
  // Keep image logic simple and compatible with both `images` and old `imageUrl`
  let imageUrls = [];

  if (campground.images && campground.images.length > 0) {
    imageUrls = campground.images.map(img => img.url);
  } else if (Array.isArray(campground.imageUrl) && campground.imageUrl.length > 0) {
    imageUrls = campground.imageUrl;
  } else if (campground.imageUrl && typeof campground.imageUrl === "string") {
    imageUrls = [campground.imageUrl];
  } else {
    imageUrls = ["/images/placeholder.jpg"];
  }

  const isOwner =
    currentUser &&
    campground.author &&
    campground.author.equals(currentUser._id);
%>

<div class="container py-4">
  <div class="row g-4">
    <!-- LEFT: Campground -->
    <div class="col-12 col-md-6">
      <div class="card shadow-sm h-100">
        <!-- Carousel -->
        <div id="campgroundImages" class="carousel slide" data-bs-ride="carousel">
          <div class="carousel-inner">
            <% imageUrls.forEach((url, index) => { %>
              <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
                <img
                  src="<%= url %>"
                  class="d-block w-100"
                  alt="Campground image"
                  onerror="this.onerror=null;this.src='/images/placeholder.jpg';"
                >
              </div>
            <% }) %>
          </div>

          <% if (imageUrls.length > 1) { %>
            <button class="carousel-control-prev" type="button" data-bs-target="#campgroundImages" data-bs-slide="prev">
              <span class="carousel-control-prev-icon"></span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#campgroundImages" data-bs-slide="next">
              <span class="carousel-control-next-icon"></span>
            </button>
          <% } %>
        </div>

        <div class="card-body d-flex flex-column">
          <h2 class="mb-1"><%= campground.name %></h2>
          <p class="text-muted mb-2"><%= campground.location %></p>
          <p class="small text-muted mb-3">
            Posted by - <%= campground.author ? campground.author.username : "Unknown" %>
          </p>

          <p class="flex-grow-1"><%= campground.description %></p>
          <h5 class="fw-bold mb-3">Price: <%= campground.price %></h5>

          <div class="d-flex gap-2 mt-auto">
            <% if (isOwner) { %>
              <a href="/campgrounds/edit/<%= campground._id %>" class="btn btn-primary">Edit</a>

              <form action="/campgrounds/<%= campground._id %>?_method=delete" method="POST">
                <button class="btn btn-danger">Delete</button>
              </form>
            <% } %>

            <a href="/campgrounds" class="btn btn-secondary">Back</a>
          </div>
        </div>
      </div>
    </div>

    <!-- RIGHT: Review form + list -->
    <div class="col-12 col-md-6">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <h3 class="text-center mb-3">Leave a Review</h3>

          <form
            action="/campgrounds/<%= campground._id %>/review"
            method="POST"
            class="needs-validation"
            novalidate
          >
            <div class="mb-3">
              <label class="form-label fw-bold text-muted">Rate Camp</label>
              <fieldset class="starability-basic">
                <input type="radio" id="no-rate" class="input-no-rate" name="rating" value="1" checked aria-label="No rating.">
                <input type="radio" id="rate1" name="rating" value="1"><label for="rate1" title="Terrible">1 star</label>
                <input type="radio" id="rate2" name="rating" value="2"><label for="rate2" title="Not good">2 stars</label>
                <input type="radio" id="rate3" name="rating" value="3"><label for="rate3" title="Average">3 stars</label>
                <input type="radio" id="rate4" name="rating" value="4"><label for="rate4" title="Very good">4 stars</label>
                <input type="radio" id="rate5" name="rating" value="5"><label for="rate5" title="Amazing">5 stars</label>
              </fieldset>
            </div>

            <div class="mb-3">
              <label class="form-label fw-bold text-muted">Comment</label>
              <textarea class="form-control" name="body" rows="3" required></textarea>
              <div class="invalid-feedback">Review field cannot be empty!</div>
            </div>

            <button class="btn btn-success w-100 fw-bold">Submit</button>
          </form>

          <hr class="my-4">

          <h4 class="text-center mb-3">Reviews</h4>

          <% campground.reviews.forEach(review => { %>
            <div class="card mb-3 bg-light border-0">
              <div class="card-body">
                <p class="mb-1 small text-muted">
                  Posted by - <%= review.author ? review.author.username : "Unknown" %>
                </p>

                <p class="mb-2"><i><%= review.body %></i></p>

                <p class="starability-result mb-2" data-rating="<%= review.rating %>">
                  Rating: <%= review.rating %> stars
                </p>

                <% if (currentUser && review.author && review.author.equals(currentUser._id)) { %>
                  <form action="/campgrounds/<%= campground._id %>/review/<%= review._id %>?_method=delete" method="POST">
                    <button class="btn btn-sm btn-outline-danger">Delete</button>
                  </form>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  </div>
</div>