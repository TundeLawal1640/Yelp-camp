<% layout('layouts/boilerplate') %>

<style>
  .auth-container {
    min-height: 85vh;
  }

  .auth-image {
    background:
      linear-gradient(rgba(0, 0, 0, 0.45), rgba(0, 0, 0, 0.45)),
      url("https://images.pexels.com/photos/5678622/pexels-photo-5678622.jpeg");
    background-size: cover;
    background-position: center;
  }

  .auth-overlay {
    color: white;
  }

  .auth-overlay h2 {
    font-weight: 700;
  }

  /* FIX LABEL VISIBILITY */
  .form-label {
    color: #1f2937;
    font-weight: 600;
  }

  /* Optional UI polish */
  .form-control {
    border-radius: 8px;
  }

  .form-control:focus {
    border-color: #ffc107;
    box-shadow: 0 0 0 0.15rem rgba(255, 193, 7, 0.25);
  }
</style>

<div class="container auth-container d-flex align-items-center">
  <div class="row shadow-lg rounded overflow-hidden w-100">
    <!-- Left Image Section -->
    <div
      class="col-md-6 d-none d-md-flex auth-image align-items-center justify-content-center"
    >
      <div class="text-center auth-overlay px-4">
        <h2 class="mb-3">Join YelpCamp</h2>
        <p class="opacity-75">
          Discover breathtaking campgrounds and share your outdoor adventures
          with explorers around the world.
        </p>
      </div>
    </div>

    <!-- Right Form Section -->
    <div class="col-md-6 bg-white p-5">
      <h3 class="text-center text-black mb-4">Create Account</h3>

      <form
        action="/users/signup"
        method="POST"
        class="needs-validation"
        novalidate
      >
        <div class="mb-3">
          <label class="form-label">Email</label>
          <input type="email" name="email" class="form-control" required />
          <div class="invalid-feedback">Please provide a valid email.</div>
        </div>

        <div class="mb-3">
          <label class="form-label">Username</label>
          <input type="text" name="username" class="form-control" required />
          <div class="invalid-feedback">Username is required.</div>
        </div>

        <div class="mb-4">
          <label class="form-label">Password</label>
          <input
            type="password"
            name="password"
            class="form-control"
            required
          />
          <div class="invalid-feedback">Password is required.</div>
        </div>

        <button type="submit" class="btn btn-primary w-100 fw-semibold">
          SIGN UP
        </button>

        <p class="text-center text-black mt-3 small">
          Already have an account?
          <a href="/users/signin">Login</a>
        </p>
      </form>
    </div>
  </div>
</div>
